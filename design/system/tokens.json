{
  "name": "MemberSpark design system",
  "version": "0.1.0",
  "prefix": "ms",
  "about": "Every token becomes a CSS custom property: color.text in a theme is --ms-color-text, space.4 is --ms-space-4. tokens.css carries the same values. products holds each product's accent and its on-accent colour, light and dark: a product sets data-product on the page and tokens.css gives it --ms-color-accent and --ms-color-on-accent. textPairs lists every foreground/background pair used for text; each clears 4.5:1 in both themes. controlPairs lists every colour that draws a control boundary (a field or button border, the focus ring) against what lies beside it; each clears 3:1 in both themes.",
  "type": {
    "font-display": "'Bricolage Grotesque', Figtree, 'Segoe UI', system-ui, sans-serif",
    "font-body": "Figtree, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "size-sm": "0.875rem",
    "size-base": "1rem",
    "size-lg": "1.125rem",
    "size-h3": "1.25rem",
    "size-h2": "1.75rem",
    "size-h1": "2.5rem",
    "size-display": "3.25rem",
    "line-height": "1.375",
    "line-height-tight": "1.15",
    "weight-regular": "400",
    "weight-medium": "600",
    "weight-bold": "700",
    "weight-heavy": "800"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "gutter": "clamp(1.1rem, 4vw, 3rem)"
  },
  "radius": {
    "sm": "10px",
    "md": "12px",
    "lg": "16px",
    "xl": "18px",
    "pill": "999px"
  },
  "size": {
    "tap": "44px",
    "header-row-min": "56px",
    "header-row-max": "80px",
    "icon": "24px",
    "tile": "36px",
    "reading": "46rem",
    "page": "1180px"
  },
  "brand": {
    "name": "MemberSpark",
    "motto": "Crafted by makers, for makers.",
    "stripe": {
      "1": "#a4bc45",
      "2": "#00eeb9",
      "3": "#07b9a7",
      "4": "#372f8f",
      "5": "#eb208c",
      "6": "#f9552c",
      "7": "#fa8c2e"
    }
  },
  "products": {
    "memberspark": { "light": { "accent": "#f5a623", "on-accent": "#15172a" }, "dark": { "accent": "#f5a623", "on-accent": "#15172a" } },
    "galleryspark": { "light": { "accent": "#6b4fc8", "on-accent": "#ffffff" }, "dark": { "accent": "#7b5fd8", "on-accent": "#ffffff" } },
    "fundingspark": { "light": { "accent": "#6b4fc8", "on-accent": "#ffffff" }, "dark": { "accent": "#7b5fd8", "on-accent": "#ffffff" } },
    "tasksparkle": { "light": { "accent": "#2b5fc7", "on-accent": "#ffffff" }, "dark": { "accent": "#3a6fd8", "on-accent": "#ffffff" } },
    "societyspark": { "light": { "accent": "#2a7a3f", "on-accent": "#ffffff" }, "dark": { "accent": "#2e7d32", "on-accent": "#ffffff" } },
    "grabaspot": { "light": { "accent": "#0f6e64", "on-accent": "#ffffff" }, "dark": { "accent": "#168075", "on-accent": "#ffffff" } }
  },
  "themes": {
    "light": {
      "color": {
        "page": "#faf8f3",
        "surface": "#ffffff",
        "surface-muted": "#f1eee6",
        "line": "#e4dfd3",
        "line-strong": "#858072",
        "text": "#142a5c",
        "text-muted": "#4b5878",
        "link": "#2050c8",
        "link-hover": "#0f2463",
        "focus": "#1d3a8a",
        "accent": "#f5a623",
        "on-accent": "#15172a",
        "primary": "#1d3a8a",
        "on-primary": "#ffffff",
        "danger": "#b3261e",
        "badge": {
          "paid": { "bg": "#e3f4ea", "fg": "#17603c" },
          "due": { "bg": "#fff3dc", "fg": "#7a4a00" },
          "lapsed": { "bg": "#fbe7e4", "fg": "#8f2a20" }
        },
        "tile": {
          "gold": "#f5a623",
          "blue": "#7fb3ff",
          "violet": "#c7a6ff",
          "green": "#8fe0b4",
          "coral": "#ff7a59"
        },
        "on-tile": "#15172a"
      },
      "shadow": {
        "card": "0 1px 2px rgba(20, 42, 92, 0.06), 0 8px 24px rgba(20, 42, 92, 0.06)",
        "raised": "0 2px 4px rgba(20, 42, 92, 0.08), 0 12px 32px rgba(20, 42, 92, 0.12)"
      }
    },
    "dark": {
      "color": {
        "page": "#10121f",
        "surface": "#1f2238",
        "surface-muted": "#262a45",
        "line": "#33375a",
        "line-strong": "#737793",
        "text": "#f3f4f8",
        "text-muted": "#9ea4c4",
        "link": "#9ec2ff",
        "link-hover": "#c7dbff",
        "focus": "#ffd27a",
        "accent": "#f5a623",
        "on-accent": "#15172a",
        "primary": "#f5a623",
        "on-primary": "#15172a",
        "danger": "#ff8a80",
        "badge": {
          "paid": { "bg": "#173d2a", "fg": "#8fe0b4" },
          "due": { "bg": "#45320a", "fg": "#ffd27a" },
          "lapsed": { "bg": "#4d1f1a", "fg": "#ffb4a8" }
        },
        "tile": {
          "gold": "#f5a623",
          "blue": "#7fb3ff",
          "violet": "#c7a6ff",
          "green": "#8fe0b4",
          "coral": "#ff7a59"
        },
        "on-tile": "#15172a"
      },
      "shadow": {
        "card": "0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.3)",
        "raised": "0 2px 4px rgba(0, 0, 0, 0.45), 0 12px 32px rgba(0, 0, 0, 0.4)"
      }
    }
  },
  "textPairs": [
    { "fg": "text", "bg": "page" },
    { "fg": "text", "bg": "surface" },
    { "fg": "text", "bg": "surface-muted" },
    { "fg": "text-muted", "bg": "page" },
    { "fg": "text-muted", "bg": "surface" },
    { "fg": "text-muted", "bg": "surface-muted" },
    { "fg": "link", "bg": "page" },
    { "fg": "link", "bg": "surface" },
    { "fg": "link-hover", "bg": "surface" },
    { "fg": "danger", "bg": "page" },
    { "fg": "danger", "bg": "surface" },
    { "fg": "on-primary", "bg": "primary" },
    { "fg": "surface", "bg": "danger" },
    { "fg": "on-accent", "bg": "accent" },
    { "fg": "badge-paid-fg", "bg": "badge-paid-bg" },
    { "fg": "badge-due-fg", "bg": "badge-due-bg" },
    { "fg": "badge-lapsed-fg", "bg": "badge-lapsed-bg" },
    { "fg": "on-tile", "bg": "tile-gold" },
    { "fg": "on-tile", "bg": "tile-blue" },
    { "fg": "on-tile", "bg": "tile-violet" },
    { "fg": "on-tile", "bg": "tile-green" },
    { "fg": "on-tile", "bg": "tile-coral" }
  ],
  "controlPairs": [
    { "fg": "line-strong", "bg": "surface" },
    { "fg": "line-strong", "bg": "page" },
    { "fg": "line-strong", "bg": "surface-muted" },
    { "fg": "focus", "bg": "surface" },
    { "fg": "focus", "bg": "page" },
    { "fg": "focus", "bg": "surface-muted" },
    { "fg": "danger", "bg": "surface" }
  ]
}
