# The app's security headers ride on every page and file the app
# serves (issue #70). The policy names only the app's own origin:
# the app loads its own script, styles and icons, talks to its own
# API and socket, and is framed by nobody. The self-host server
# sends the same headers from its own code; the two lists are
# kept alike by hand.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
# The app files' cache lives follow Part 8's rule for a file
# whose name stays the same when its bytes change: one hour
# fresh, then stale-while-revalidate for up to a day — fresh
# enough that a new release is never far off, and no visit
# stalls waiting on a revalidation round trip.
/boot.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# The front page itself is a page (Site and Email Standards,
# Part 8): it states the revalidation line in full.
/
  Cache-Control: max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: max-age=0, must-revalidate, no-transform
/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# The build file the version check reads (issue #10): a short
# life, so a new build's stamp is never long behind the build
# itself. The app asks for it uncached in any case.
/build.json
  Cache-Control: public, max-age=60
/styles.css
  Cache-Control: no-cache
/tokens.css
  Cache-Control: no-cache
# The manifest and the worker script take the same-name life
# with the app files. The manifest also names its own content
# type, the one browsers ask for by name.
/manifest.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/manifest+json
/sw.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# Icons keep a short life of one day (Part 8), the favicon
# with them.
/favicon.ico
  Cache-Control: public, max-age=86400
/icons/icon-192.png
  Cache-Control: public, max-age=86400
/icons/icon-512.png
  Cache-Control: public, max-age=86400
/icons/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/icons/icon-180.png
  Cache-Control: public, max-age=86400
/icons/icon-64.png
  Cache-Control: public, max-age=86400
/icons/icon.svg
  Cache-Control: public, max-age=86400
# The fonts revalidate, so a new cut of either is what every
# open gets.
/fonts/comfortaa-bold.woff2
  Cache-Control: no-cache
/fonts/bricolage-grotesque.woff2
  Cache-Control: no-cache
